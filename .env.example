# Copy this file to .env and fill in real values. Never commit .env.
# Secrets listed here are server-side only. Do NOT expose them via VITE_ variables.

# --- Hardhat / Sepolia deployment (npm run deploy:sepolia) ---
# HTTPS RPC endpoint from Infura or Alchemy.
SEPOLIA_RPC_URL=
# Throwaway Sepolia-only wallet private key (the deployer becomes contract owner).
DEPLOYER_PRIVATE_KEY=
# Optional: enables automatic contract verification on Etherscan.
ETHERSCAN_API_KEY=

# --- Node API server (npm run server) ---
PORT=8787
# Tavily API key for live opportunity search. Without it the server returns
# the labeled evergreen fallback list.
TAVILY_API_KEY=
# Optional: enables AI chat at /api/assistant. Without it the endpoint returns
# a clear 503 configuration error; the roadmap generator still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated allowed browser origins for the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
